# Invio del modulo contatti.
#
# Il messaggio esce via SMTP dalla casella della professionista e arriva alla
# professionista: nessun servizio di moduli in mezzo. SMTP lo parlano tutti i
# provider — Aruba, Register, Brevo, Resend — quindi si cambia fornitore
# toccando solo questi valori.
#
# Su Vercel vanno inserite in Settings → Environment Variables, NON in questo
# file, che è solo un promemoria dei nomi. La password non va mai nel codice.

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Da quale indirizzo partono i messaggi. Se assente, si usa SMTP_USER.
#
# Con una casella normale le due cose coincidono e questa riga si lascia vuota.
# Con un servizio transazionale no: lì SMTP_USER è un codice tecnico del tipo
# `8a1b2c@smtp-brevo.com`, e spedire da quello fa finire tutto nello spam.
# In quel caso qui va un indirizzo verificato su un dominio proprio.
EMAIL_MITTENTE=

# Dove recapitare i messaggi. Se assente, si usa l'indirizzo pubblicato sul
# sito (contenuti.ts → studio.email).
EMAIL_DESTINATARIO=

# ---------------------------------------------------------------------------
# Valori per Aruba, che ospita abafriendly.it:
#
#   SMTP_HOST=smtps.aruba.it
#   SMTP_PORT=465
#   SMTP_USER=soniamadonia@abafriendly.it   (o una casella dedicata al sito)
#   SMTP_PASSWORD=...
#
# Valori per Brevo, se si preferisce non usare una casella della dott.ssa:
#
#   SMTP_HOST=smtp-relay.brevo.com
#   SMTP_PORT=587
#   SMTP_USER=...@smtp-brevo.com
#   SMTP_PASSWORD=...                       (la chiave SMTP, non la password)
#   EMAIL_MITTENTE=...                      (mittente verificato su Brevo)
#   EMAIL_DESTINATARIO=soniamadonia@abafriendly.it
